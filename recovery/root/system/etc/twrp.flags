# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point    fstype     device                 device2                        flags
# TWRP Fstab - For Moto G84 5G
# WearyUI Project 

# <mount_point>      <fstype>  <device>        <device2>                  <flags>
/data                  f2fs      /dev/block/bootdevice/by-name/userdata           flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0;keydirectory=/metadata/vold/metadata_encryption;metadata_encryption=aes-256-xts:wrappedkey_v0
/misc                  emmc      /dev/block/bootdevice/by-name/misc
/efs1                  emmc      /dev/block/bootdevice/by-name/modemst1           flags=backup=1;display="EFS"
/efs2                  emmc      /dev/block/bootdevice/by-name/modemst2           flags=backup=1;subpartitionof=/efs1
# Persist Partitions
/persist               ext4      /dev/block/bootdevice/by-name/persist            flags=backup=1;display="Persist"
/prodpersist           ext4      /dev/block/bootdevice/by-name/prodpersist        flags=backup=1;display="Product Persist"
/firmware_mnt          ext4      /dev/block/bootdevice/by-name/modem              flags=display="Firmware";mounttodecrypt;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0";slotselect
/fsg                   ext4      /dev/block/bootdevice/by-name/fsg                flags=backup=1;display="FSG";fsflags="ro,context=u:object_r:fsg_file:s0";slotselect
/bt_firmware           ext4      /dev/block/bootdevice/by-name/bluetooth          flags=backup=1;display="Bluetooth";fsflags="ro,context=u:object_r:bt_firmware_file:s0";slotselect
/dsp                   ext4      /dev/block/bootdevice/by-name/dsp                flags=backup=1;display="DSP";slotselect
/metadata              ext4      /dev/block/bootdevice/by-name/metadata           flags=backup=1;display="Metadata"
/logo                  emmc      /dev/block/bootdevice/by-name/logo               flags=backup=1;display="Logo";slotselect
/keymaster             emmc      /dev/block/bootdevice/by-name/keymaster          flags=slotselect

# Removable storage (MicroSD && USB-OTG)
/external_sd           auto      /dev/block/mmcblk1p1    /dev/block/mmcblk1       flags=display="Micro SD Card";storage;wipeingui;removable
/usb-otg               auto      /dev/block/sdg1         /dev/block/sdg           flags=display="USB OTG";storage;wipeingui;removable

# Flashable Logical Partitions
/system_a           emmc        /dev/block/mapper/system_a                                flags=backup=1;flashimg=1;slotselect;display="System Image A"
/vendor_a           emmc        /dev/block/mapper/vendor_a                                flags=backup=1;flashimg=1;slotselect;display="Vendor Image A"
/product_a          emmc        /dev/block/mapper/product_a                               flags=backup=1;flashimg=1;slotselect;display="Product Image A"
/system_ext_a       emmc        /dev/block/mapper/system_ext_a                            flags=backup=1;flashimg=1;slotselect;display="System_EXT Image A"
/boot_a             emmc        /dev/block/by-name/boot_a                                 flags=backup=1;flashimg=1;slotselect;display="Boot_a"
/vendor_boot_a      emmc        /dev/block/by-name/vendor_boot_a                          flags=backup=1;flashimg=1;slotselect;display="Vendor Boot_a"
/vbmeta_a           emmc        /dev/block/by-name/vbmeta_a                               flags=backup=1;flashimg=1;slotselect;display="Vbmeta_a"
/dtbo_a             emmc        /dev/block/by-name/dtbo_a                                 flags=backup=1;flashimg=1;slotselect;display="Dtbo_a"
/vbmeta_system_a    emmc        /dev/block/by-name/vbmeta_system_a                        flags=backup=1;flashimg=1;slotselect;display="Vbmeta_system_a"

/system_b           emmc        /dev/block/mapper/system_b                                flags=backup=1;flashimg=1;slotselect;display="System Image B"
/vendor_b           emmc        /dev/block/mapper/vendor_b                                flags=backup=1;flashimg=1;slotselect;display="Vendor Image B"
/product_b          emmc        /dev/block/mapper/product_b                               flags=backup=1;flashimg=1;slotselect;display="Product Image B"
/system_ext_b       emmc        /dev/block/mapper/system_ext_b                            flags=backup=1;flashimg=1;slotselect;display="System_EXT Image B"
/boot_b             emmc        /dev/block/by-name/boot_b                                 flags=backup=1;flashimg=1;slotselect;display="Boot_b"
/vendor_boot_b      emmc        /dev/block/by-name/vendor_boot_b                          flags=backup=1;flashimg=1;slotselect;display="Vendor Boot_b"
/vbmeta_b           emmc        /dev/block/by-name/vbmeta_b                               flags=backup=1;flashimg=1;slotselect;display="Vbmeta_b"
/dtbo_b             emmc        /dev/block/by-name/dtbo_b                                 flags=backup=1;flashimg=1;slotselect;display="Dtbo_b"
/vbmeta_system_b    emmc        /dev/block/by-name/vbmeta_system_b                        flags=backup=1;flashimg=1;slotselect;display="Vbmeta_system_b"
